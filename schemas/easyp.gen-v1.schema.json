                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "java_package_prefix"
                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "java_package_suffix"
                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "java_multiple_files"
