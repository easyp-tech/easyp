                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "ruby_package"
                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "ruby_package_suffix"
                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "php_namespace"
                        }
                      },
                      "required": [
                        "file_option"
                      ]
                    },
                    "then": {
                      "properties": {
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "file_option": {
                          "const": "php_metadata_namespace"
